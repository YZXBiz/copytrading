{
  "about": "What `setup apply` does to live accounts, for the engine to decide whether the owner approves. The app (agentApplyFacts) and the CLI tests' stand-in app both compute these from the saved setup and the unsaved draft. Accounts are known by the name they were saved under (saved_name; null for a new one), and a guru by their channel, which gives them their ID. `start` is `setup apply --start` (false when absent).",
  "cases": [
    {
      "name": "a live account's limits change while copying runs",
      "copying": true,
      "saved": {
        "accounts": [
          {
            "id": "live-main",
            "environment": "live",
            "max_order_usd": "100"
          }
        ],
        "routes": [
          {
            "channel": "123",
            "account": "live-main"
          }
        ]
      },
      "draft": {
        "accounts": [
          {
            "id": "live-main",
            "saved_name": "live-main",
            "environment": "live",
            "max_order_usd": "50000",
            "keys_typed": false
          }
        ],
        "routes": [
          {
            "channel": "123",
            "account": "live-main"
          }
        ]
      },
      "facts": {
        "made_live": [],
        "new_live_keys": [],
        "changed_live": [
          "live-main"
        ],
        "starts_live": []
      }
    },
    {
