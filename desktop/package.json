{
  "name": "copytrading-desktop",
  "private": true,
  "version": "0.0.0",
  "description": "CopyTrading desktop app (Electron + React)",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "capture": "electron-vite build && node scripts/capture.mjs",
    "package": "electron-vite build && electron-builder --dir --arm64"
  },
  "build": {
    "appId": "dev.copytrading.app",
    "productName": "CopyTrading",
    "directories": {
      "output": "dist/package"
    },
    "files": [
      "dist/main/**",
      "dist/preload/**",
      "dist/renderer/**",
      "package.json",
      "!node_modules/**"
    ],
    "npmRebuild": false,
    "mac": {
      "target": "dir",
      "identity": null,
      "icon": "resources/AppIcon.icns",
      "category": "public.app-category.finance",
      "minimumSystemVersion": "26.0"
    },
    "publish": {
      "provider": "github",
      "owner": "YZXBiz",
      "repo": "copytrading"
    }
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@number-flow/react": "^0.6.2",
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.26",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "electron-updater": "^6.8.11",
    "motion": "^14.9.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "recharts": "^3.8.0",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0"
  }
}
